# Copy to .env for local dev. NEVER commit a real .env.
# On the VPS the same file lives at the repo root and is loaded by both
# systemd units (datainfo-api, datainfo-celery).

# Application
APP_NAME="Scraply API"
APP_VERSION="2.0.0"
DEBUG=False
API_PREFIX="/api/v1"
ENVIRONMENT=development

# Production only: public host + TLS (drives CORS and the URLs printed at boot)
# DOMAIN_NAME=nicky.tools
# USE_HTTPS=True

# Server
HOST="0.0.0.0"
PORT=8000
WORKERS=2

# Security (generate: openssl rand -hex 32)
SECRET_KEY="CHANGE_THIS_SECURE_KEY_USE_openssl_rand_hex_32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Required at registration; hand it to the people who may create accounts.
ADMIN_SECRET_KEY="change-me"

# CORS origins (comma-separated). Empty = derived from ENVIRONMENT/DOMAIN_NAME.
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

# Postgres
POSTGRES_SERVER="localhost"
POSTGRES_USER="automation_user"
POSTGRES_PASSWORD="automation_password"
POSTGRES_DB="automation_db"
# Or a full URL (async driver). Tests use sqlite+aiosqlite://
# DATABASE_URL="postgresql+asyncpg://user:pass@localhost/dbname"

# Redis (Celery broker + result backend)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
# REDIS_URL="redis://localhost:6379/0"

# Uploads
MAX_UPLOAD_SIZE=104857600  # 100MB

# Job execution
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT=129600  # 36 hours
RETRY_MAX_ATTEMPTS=3
RETRY_DELAY=60

# company.info login used by the scraper
COMPANYINFO_EMAIL="your-email@example.com"
COMPANYINFO_PASSWORD="your-password"
COMPANYINFO_URL="https://company.info"

# Chrome / Selenium
CHROME_PROFILE_PATH=""
CHROME_PROFILE_NAME="Default"
HEADLESS_MODE=True
# Parallel browser workers per job. The Settings page writes this value.
MAX_WORKERS=1

# Monitoring (optional)
# SENTRY_DSN=
ENABLE_METRICS=True
