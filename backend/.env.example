# ========================
# Backend Environment Variables
# ========================

# Application
APP_NAME="Automation Platform API"
APP_VERSION="1.0.0"
DEBUG=False
API_PREFIX="/api/v1"

# Server
HOST="0.0.0.0"
PORT=8000
WORKERS=2

# Security (IMPORTANT: Change SECRET_KEY in production!)
SECRET_KEY="CHANGE_THIS_SECURE_KEY_USE_openssl_rand_hex_32"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000"

# ========================
# Database (PostgreSQL)
# ========================
POSTGRES_SERVER="localhost"
POSTGRES_USER="automation_user"
POSTGRES_PASSWORD="automation_password"
POSTGRES_DB="automation_db"
# Or use full URL:
# DATABASE_URL="postgresql+asyncpg://user:pass@localhost/dbname"

# ========================
# Redis (Job Queue & Cache)
# ========================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
# Or use full URL:
# REDIS_URL="redis://localhost:6379/0"

# ========================
# Celery (Background Jobs)
# ========================
# Uses Redis settings above by default
# CELERY_BROKER_URL="redis://localhost:6379/0"
# CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# ========================
# File Storage
# ========================
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes

# ========================
# Job Execution
# ========================
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT=21600  # 6 hours in seconds
RETRY_MAX_ATTEMPTS=3
RETRY_DELAY=60  # seconds

# ========================
# CompanyInfo Tool Settings
# ========================
COMPANYINFO_EMAIL="your-email@example.com"
COMPANYINFO_PASSWORD="your-password"
COMPANYINFO_URL="https://www.companyinfo.com/search"

# ========================
# Chrome/Selenium Settings
# ========================
CHROME_PROFILE_PATH=""
CHROME_PROFILE_NAME="Default"
HEADLESS_MODE=True
MAX_WORKERS=1

# ========================
# Monitoring (Optional)
# ========================
# SENTRY_DSN="https://your-sentry-dsn@sentry.io/project"
ENABLE_METRICS=True

# ========================
# Email Notifications (Optional)
# ========================
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-app-password"
# NOTIFICATION_EMAIL="alerts@yourdomain.com"
