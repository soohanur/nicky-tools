# Root env for docker-compose.yml (local stack). Copy to .env - never commit it.
# The VPS deploy uses backend/.env instead (see deploy.sh + backend/.env.example).

# Backend
SECRET_KEY=change-this-to-a-long-random-string
ADMIN_SECRET_KEY=change-me
ENVIRONMENT=development
DEBUG=False

# Database
POSTGRES_USER=automation_user
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=automation_db

# company.info login used by the scraper worker
COMPANYINFO_EMAIL=
COMPANYINFO_PASSWORD=
COMPANYINFO_URL=https://company.info

# Frontend (baked in at build time). Empty = same origin (nginx proxies /api/).
NEXT_PUBLIC_API_URL=http://localhost:8000
